{
	"name": "build-helper",
	"version": "0.0.1",
	"description": "build-helper",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm,cjs --dts --clean --out-dir dist",
		"dev": "tsx watch src/index.ts",
		"publish": "node bin/publish.js"
	},
	"keywords": [
		"build",
		"uniapp",
		"hbuilder"
	],
	"author": "https://github.com/chinjiaqing",
	"license": "ISC",
	"devDependencies": {
		"@antfu/eslint-config": "^8.2.0",
		"@types/fs-extra": "^11.0.4",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^22.19.17",
		"eslint": "^10.2.0",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"chalk": "^5.6.2",
		"execa": "^9.6.1",
		"fs-extra": "^11.3.5"
	}
}
