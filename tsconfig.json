{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler", // 现代打包工具（tsup/vite）最推荐的模式
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "ignoreDeprecations":"6.0",
    "types": ["node"]
  },
  "include": ["src/**/*"]
}